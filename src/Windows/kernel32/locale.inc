/* The locales of kernel32.dll (included by kernel32.c): the table of locale_data.inc (generated by scripts/gen-locales.py) and the lookups of locales by identifier and by name. A
 * "kind" in the NLS functions is the number of a locale in the table plus one (0: there is no such locale). */

#include "locale_data.inc"

#define NLS_LCID_INVARIANT 0x7Fu
#define NLS_LCID_EN_US 0x409u

/* The number of the locale with an identifier in the table, or -1. */
static int nls_index_of_lcid(DWORD lcid) {
  int lo = 0, hi = NLS_LOCALE_COUNT;
  while (lo < hi) {
    const int mid = lo + (hi - lo) / 2;
    if (k_locale_lcid[mid] < lcid) lo = mid + 1; else if (k_locale_lcid[mid] > lcid) hi = mid; else return mid;
  }
  return -1;
}
/* The default locales: the user's and the system's are English (United States). */
static int nls_default_kind(void) { return nls_index_of_lcid(NLS_LCID_EN_US) + 1; }
static int nls_invariant_kind(void) { return nls_index_of_lcid(NLS_LCID_INVARIANT) + 1; }

/* Which locale an LCID names: the specific locale for a neutral one, the user's for the "default" identifiers, 0 for one that does not exist. */
static int nls_locale_of(LCID lcid) {
  switch (lcid) {
    case 0: case 0x400: case 0x800: case 0xC00: case 0x1000: case 0x1400: case 0x2000: return nls_default_kind();
    default: break;
  }
  if ((lcid & 0xFFFF) == NLS_LCID_INVARIANT && (lcid >> 16) <= 1) return nls_invariant_kind();
  const int index = nls_index_of_lcid(lcid);
  return index < 0 ? 0 : k_locale_default[index] + 1;
}
static BOOL nls_kind_is_neutral(int kind) { return kind > 0 && k_locale_default[kind - 1] != kind - 1; }

/* The slot of a LOCALE_ value in the rows of the table, or -1. */
static int nls_slot_of(DWORD base) {
  int lo = 0, hi = NLS_SLOT_COUNT;
  while (lo < hi) {
    const int mid = lo + (hi - lo) / 2;
    if (k_locale_types[mid] < base) lo = mid + 1; else if (k_locale_types[mid] > base) hi = mid; else return mid;
  }
  return -1;
}
/* The text (UTF-8) of a LOCALE_ value of a locale, or NULL if the value does not exist. */
static const char *nls_text_of(int kind, DWORD base) {
  const int slot = nls_slot_of(base);
  if (kind <= 0 || slot < 0) return NULL;
  return k_locale_pool + k_locale_strings[kind - 1][slot];
}
/* The same in wide characters; FALSE if the value does not exist. At most 79 characters are copied. */
static BOOL nls_text_wide(int kind, DWORD base, WCHAR *out /* 80 */) {
  const char *text = nls_text_of(kind, base);
  if (!text) return FALSE;
  const int n = MultiByteToWideChar(CP_UTF8, 0, text, -1, out, 80);
  if (n == 0) { out[79] = 0; MultiByteToWideChar(CP_UTF8, 0, text, 79, out, 79); }
  return TRUE;
}

static WCHAR nls_lower(WCHAR c) { return c >= 'A' && c <= 'Z' ? (WCHAR)(c + 32) : c; }
static BOOL nls_name_is(const WCHAR *name, const char *text) {
  for (; *text; ++text, ++name) if (nls_lower(*name) != (WCHAR)nls_lower((BYTE)*text)) return FALSE;
  return *name == 0;
}

/* The locale a name picks: NULL the user's, "" the invariant locale, otherwise the locale of that name (a neutral one stays neutral). */
static int nls_locale_of_name(LPCWSTR name) {
  if (!name) return nls_default_kind();
  if (*name == 0) return nls_invariant_kind();
  if (nls_name_is(name, "!x-sys-default-locale")) return nls_default_kind();
  const int slot = nls_slot_of(0x5C);
  for (int i = 0; i < NLS_LOCALE_COUNT; ++i) {
    const char *candidate = k_locale_pool + k_locale_strings[i][slot];
    if (*candidate && nls_name_is(name, candidate)) return i + 1;
  }
  return 0;
}

/* The day and month names of a locale (the first day is Monday, the first month January), as wide characters. */
static const WCHAR *nls_day_name(int kind, int weekday /* 0 = Sunday */, BOOL abbreviated, WCHAR *scratch) {
  if (!nls_text_wide(kind, (abbreviated ? 0x31u : 0x2Au) + (DWORD)((weekday + 6) % 7), scratch)) scratch[0] = 0;
  return scratch;
}
static const WCHAR *nls_month_name(int kind, int month, BOOL abbreviated, WCHAR *scratch) {
  if (!nls_text_wide(kind, (abbreviated ? 0x44u : 0x38u) + (DWORD)((month - 1) % 12), scratch)) scratch[0] = 0;
  return scratch;
}
