/* The text of a system message for a code (an HRESULT of the Win32 facility is its error), or NULL. */
static const char *system_message_text(DWORD code) {
  for (int pass = 0; pass < 2; ++pass) {
    size_t_ low = 0, high = sizeof kSystemMessages / sizeof kSystemMessages[0];
    while (low < high) {
      const size_t_ mid = low + (high - low) / 2;
      if (kSystemMessages[mid].code == code) return kSystemMessages[mid].text;
      if (kSystemMessages[mid].code < code) low = mid + 1; else high = mid;
    }
    if ((code & 0xFFFF0000u) != 0x80070000u) break;
    code &= 0xFFFFu;      /* HRESULT_FROM_WIN32: the Win32 error's text */
  }
  return NULL;
}
