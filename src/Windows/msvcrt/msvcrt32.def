"??0exception@@QAE@ABQBD@Z" = msvcrt_exception_ctor_name
"??0exception@@QAE@ABV0@@Z" = msvcrt_exception_copy
"??1exception@@UAE@XZ" = msvcrt_exception_dtor
"??4exception@@QAEAAV0@ABV0@@Z" = msvcrt_exception_assign
"?what@exception@@UBEPBDXZ" = msvcrt_exception_what
"?terminate@@YAXXZ" = msvcrt_terminate
