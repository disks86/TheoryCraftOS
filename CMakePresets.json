{
  "version": 3,
  "configurePresets": [
    {
      "name": "uefi-debug",
      "displayName": "UEFI Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/toolchain-x86_64-uefi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "uefi-debug", "configurePreset": "uefi-debug" }
  ]
}
