+/* SMPTE 421M 8.3.4.11 and 8.4.4.14: a reference picture is kept as it was reconstructed (in reduced range when its RANGEREDFRM
+ * was set); when its RANGEREDFRM differs from the current picture's it is scaled before intensity compensation and motion
+ * compensation: down when only the current picture is reduced, up when only the reference is. 1: down, -1: up, 0: as it is. */
+static av_always_inline int vc1_range_adjust(const VC1Context *v, int dir)
+{
+    const Picture *ref = dir ? v->s.next_picture_ptr : v->s.last_picture_ptr;
+    return v->rangeredfrm - (ref ? ref->vc1_rangeredfrm : 0);
+}
+
+static av_always_inline int vc1_range_scale(int x, int adjust)
+{
+    return adjust > 0 ? ((x - 128) >> 1) + 128 : av_clip_uint8((x - 128) * 2 + 128);
+}
