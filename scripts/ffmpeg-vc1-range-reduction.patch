--- a/libavcodec/vc1dec.c
+++ b/libavcodec/vc1dec.c
@@ -621,6 +621,25 @@
  * @todo TODO: Handle VC-1 IDUs (Transport level?)
  * @todo TODO: Decipher remaining bits in extra_data
  */
+/* SMPTE 421M 8.1.1.4: a picture reconstructed in reduced range is output scaled up, while the reference keeps the reconstruction. */
+static int vc1_output_range(const Picture *p, AVFrame *pict)
+{
+    int ret, c, x, y;
+    if (!p->vc1_rangeredfrm)
+        return 0;
+    if ((ret = av_frame_make_writable(pict)) < 0)
+        return ret;
+    for (c = 0; c < 3; c++) {
+        const int w = c ? (pict->width + 1) >> 1 : pict->width, h = c ? (pict->height + 1) >> 1 : pict->height;
+        for (y = 0; y < h; y++) {
+            uint8_t *row = pict->data[c] + y * pict->linesize[c];
+            for (x = 0; x < w; x++)
+                row[x] = av_clip_uint8((row[x] - 128) * 2 + 128);
+        }
+    }
+    return 0;
+}
+
